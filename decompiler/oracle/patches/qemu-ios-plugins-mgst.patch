index 0000000..176dc1a
--- /dev/null
+++ b/contrib/plugins/drcov_mgst.c
@@ -0,0 +1,533 @@
+/*
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ * Based on contrib/plugins/drcov.c, Copyright (C) 2021, Ivanov Arkady
+ * <arkadiy.ivanov@ispras.ru>, GNU GPL version 2 or later (see COPYING).
+ * Modifications for MGS Touch verification: (C) 2026 mgstouch contributors, same licence.
+ *
+ * drcov_mgst - a per-process variant of contrib/plugins/drcov.c.
+ *
+ * WHY: drcov.c records every translated block's virtual address globally,
+ * with no notion of which guest PROCESS executed it. Under qemu-system-arm
+ * (this project's whole use case - an emulated iPod touch running XNU with
+ * many processes sharing one un-ASLR'd address space) that makes its output
+ * meaningless on its own: the same VA can belong to the kernel, SpringBoard,
+ * or MGSTUS depending on which was scheduled at that instant - exactly the
+ * TTBR0-identity trap this project's mgst_probe.py was built to avoid (see
+ * its module docstring and analysis/notes / LOG.md's repeated "process
+ * identity is proven, not assumed, on every read" rule).
+ *
+ * FIX: before a block counts as covered, run the same identity check that
+ * mgst_probe.py's check_context() uses: compare the 32-byte Mach-O header at
+ * guest VA 0x1000 against the reference binary's own bytes. The read goes
+ * through qemu_plugin_read_memory_vaddr(), which walks the CURRENT vCPU
+ * context, i.e. whichever process is scheduled at that exact execution.
+ *
+ * COST (v1 of this plugin got it wrong - LOG 2026-09-28 STEP 5): checking on
+ * EVERY execution of EVERY block, system-wide, under a global mutex, slowed
+ * the guest so much that MGST hit iOS's 20 s launch watchdog (0x8badf00d)
+ * on 3/3 launches. v2 cuts that cost two ways, without weakening the check:
+ *   1. Only blocks whose VA is inside [base, end) get an exec callback at
+ *      all. Kernel, dyld and dylib code (0x2fe..., 0x3..., 0xc...) run at
+ *      full TCG speed.
+ *   2. Identity is decided ONCE per translated block, on its first
+ *      execution, then cached in the block. This is sound because QEMU
+ *      keys TBs by PHYSICAL page: a TB built from SpringBoard's page at VA
+ *      0x2abc is never reused when MGSTUS runs 0x2abc; MGSTUS gets its own
+ *      TB. A write to a code page invalidates its TBs, so a recycled page
+ *      gets fresh, unchecked TBs too.
+ *
+ * Output is standard drcov v2 (Lighthouse/Dragon Dance/bncov-importable).
+ * There is a single synthetic module (id 0) at [base, end), and each BB
+ * start is an OFFSET from base, as drcov specifies. Upstream drcov.c writes
+ * absolute PCs instead. tools/mgst_coverage.py decodes the file back to
+ * absolute VAs (= Ghidra VAs, no ASLR on iOS 3) and rolls it up per
+ * function, so the project's own numbers never depend on an importer's
+ * image-base convention. qemu_plugin_path_to_binary() et al are
+ * linux-user-only APIs and don't apply here.
+ *
+ * Args (both required):
+ *   ref=<path>        MGSTUS binary whose first 32 bytes are the reference
+ *                      header (same file MGST_REF_EXE would point at)
+ *   filename=<path>    output .drcov trace
+ * Optional:
+ *   base=<hex>         __TEXT vmaddr for the module-table row (default 0x1000)
+ *   end=<hex>          end of the covered range (default 0x100000)
+ *
+ *   calls=<path>       ALSO record, as TSV (decoded by tools/mgst_calls.py):
+ *                      - "edge": every distinct MGST->MGST block transition
+ *                        (source = last insn of the previous MGST block,
+ *                        dest = next MGST block). Foreign code in between is
+ *                        invisible, so a call through objc_msgSend or a dylib
+ *                        shows up as call site -> IMP/return site. This is the
+ *                        dynamic CFG: indirect-call and jumptable targets.
+ *                      - "msg": every distinct (call site, receiver class,
+ *                        selector) at BL/BLX to the objc_msgSend,
+ *                        objc_msgSendSuper2 and objc_msgSend_stret stubs, with
+ *                        the class name read from the objc4 runtime structs
+ *                        and the selector string read from guest memory.
+ *   msgsend=<hex>,super2=<hex>,stret=<hex>  stub VAs (defaults: v2.3.0)
+ *
+ * Usage (see tools/mgst_coverage.py for the host-side wrapper):
+ *   qemu-system-arm ... -plugin contrib/plugins/libdrcov_mgst.so,ref=...,filename=...
+ */
+#include <errno.h>
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <glib.h>
+
+#include <qemu-plugin.h>
+
+QEMU_PLUGIN_EXPORT int qemu_plugin_version = QEMU_PLUGIN_VERSION;
+
+static char header[] = "DRCOV VERSION: 2\n"
+                "DRCOV FLAVOR: drcov-64\n"
+                "Module Table: version 2, count 1\n"
+                "Columns: id, base, end, entry, path\n";
+
+static FILE *fp;
+static const char *file_name = "file.drcov.trace";
+static const char *ref_path;
+static const char *module_path = "MGSTUS";
+static uint64_t mod_base = 0x1000;
+static uint64_t mod_end = 0x100000;
+static uint8_t ref_header[32];
+static bool have_ref;
+static GMutex lock;
+
+/* Per-TB identity verdict, decided on first execution (see header). */
+enum { BB_UNKNOWN = 0, BB_MGST = 1, BB_OTHER = 2 };
+
+typedef struct {
+    uint32_t start;      /* absolute VA; written as start - mod_base */
+    uint16_t size;
+    uint16_t mod_id;
+    int      state;      /* BB_* */
+    uint32_t last_insn;  /* VA of the block's last instruction (edge source) */
+    uint32_t last_succ;  /* last recorded successor: skips the hash when hot */
+} bb_entry_t;
+
+/* ---- calls= : dynamic CFG + objc_msgSend capture ---------------------- */
+static const char *calls_name;
+static uint64_t stub_msgsend = 0x5add0, stub_super2 = 0x5addc, stub_stret = 0x5ade8;
+static bb_entry_t *prev_bb;
+static GHashTable *edges;        /* (src<<32|dst) -> count of cache misses */
+static GHashTable *msgs;         /* msg_key_t* -> msg_val_t* */
+static struct qemu_plugin_register *reg_r[3];
+
+enum { K_MSGSEND = 0, K_SUPER2 = 1, K_STRET = 2 };
+static const char *kind_name[] = { "msgSend", "msgSendSuper2", "msgSend_stret" };
+
+typedef struct { uint32_t site, cls, sel; } msg_key_t;
+typedef struct { uint64_t count; int kind; int meta; char *cname; char *sname; } msg_val_t;
+typedef struct { uint32_t site; int kind; bb_entry_t *bb; msg_key_t last; } site_t;
+
+static guint msg_hash(gconstpointer p)
+{
+    const msg_key_t *k = p;
+    return k->site * 2654435761u ^ k->cls * 40503u ^ k->sel;
+}
+
+static gboolean msg_equal(gconstpointer a, gconstpointer b)
+{
+    return memcmp(a, b, sizeof(msg_key_t)) == 0;
+}
+
+static GPtrArray *blocks;
+
+/* Running counters, printed to stderr at exit - cheap sanity check that the
+ * identity gate is actually discriminating rather than passing everything
+ * or nothing (either of which would silently produce a useless trace). */
+static uint64_t checks_total, checks_matched, tbs_in_range, tbs_skipped;
+
+static bool current_context_is_mgst(void)
+{
+    static GByteArray *buf;
+    if (!buf) {
+        buf = g_byte_array_new();
+    }
+    checks_total++;
+    if (!qemu_plugin_read_memory_vaddr(0x1000, buf, sizeof(ref_header))) {
+        /* VA 0x1000 unmapped for whatever is current right now - cannot be
+         * MGST (its own __TEXT would be mapped there if it were running). */
+        return false;
+    }
+    bool match = buf->len == sizeof(ref_header) &&
+                 memcmp(buf->data, ref_header, sizeof(ref_header)) == 0;
+    if (match) {
+        checks_matched++;
+    }
+    return match;
+}
+
+static bool rd32(uint32_t va, uint32_t *out)
+{
+    static GByteArray *b;
+    if (!b) {
+        b = g_byte_array_new();
+    }
+    if (!qemu_plugin_read_memory_vaddr(va, b, 4) || b->len < 4) {
+        return false;
+    }
+    memcpy(out, b->data, 4);
+    return true;
+}
+
+static char *rdstr(uint32_t va)
+{
+    static GByteArray *b;
+    if (!b) {
+        b = g_byte_array_new();
+    }
+    if (!va || !qemu_plugin_read_memory_vaddr(va, b, 96)) {
+        return g_strdup("?");
+    }
+    return g_strndup((const char *)b->data, strnlen((const char *)b->data, 96));
+}
+
+/* objc4-437 (iOS 3): class_t {isa, super, cache, vtable, data}; data is a
+ * class_rw_t {flags, version, ro, ...} once realized (RW_REALIZED = 1<<31),
+ * else the class_ro_t itself {flags, start, size, ivarLayout, name, ...}. */
+static char *class_name(uint32_t cls, int *meta)
+{
+    uint32_t data, flags, ro, name;
+    *meta = -1;
+    if (!cls || !rd32(cls + 16, &data)) {
+        return g_strdup(cls ? "?" : "nil");
+    }
+    data &= ~3u;
+    if (!rd32(data, &flags)) {
+        return g_strdup("?");
+    }
+    ro = data;
+    if ((flags & 0x80000000u) && !rd32(data + 8, &ro)) {
+        return g_strdup("?");
+    }
+    if (!rd32(ro, &flags) || !rd32(ro + 16, &name)) {
+        return g_strdup("?");
+    }
+    *meta = flags & 1;
+    return rdstr(name);
+}
+
+static void vcpu_init(qemu_plugin_id_t id, unsigned int cpu_index)
+{
+    g_autoptr(GArray) regs = qemu_plugin_get_registers();
+    static const char *want[] = { "r0", "r1", "r2" };
+    for (guint i = 0; i < regs->len; i++) {
+        qemu_plugin_reg_descriptor *d = &g_array_index(regs, qemu_plugin_reg_descriptor, i);
+        for (int k = 0; k < 3; k++) {
+            if (g_strcmp0(d->name, want[k]) == 0) {
+                reg_r[k] = d->handle;
+            }
+        }
+    }
+    if (!reg_r[0] || !reg_r[1] || !reg_r[2]) {
+        fprintf(stderr, "drcov_mgst: r0-r2 not found in the register list; msg capture off\n");
+    }
+}
+
+static uint32_t reg32(int k)
+{
+    static GByteArray *b;
+    if (!b) {
+        b = g_byte_array_new();
+    }
+    g_byte_array_set_size(b, 0);
+    if (!reg_r[k] || qemu_plugin_read_register(reg_r[k], b) < 4) {
+        return 0;
+    }
+    uint32_t v;
+    memcpy(&v, b->data, 4);
+    return v;
+}
+
+static void msg_exec(unsigned int cpu_index, void *udata)
+{
+    site_t *st = udata;
+    if (st->bb->state != BB_MGST) {
+        return;
+    }
+    uint32_t recv, sel, cls = 0;
+    if (st->kind == K_MSGSEND) {
+        recv = reg32(0); sel = reg32(1);
+        if (recv) {
+            rd32(recv, &cls);
+        }
+    } else if (st->kind == K_SUPER2) {
+        /* r0 = struct objc_super { receiver, class }: lookup starts at
+         * class->superclass, so record the class the compiler named. */
+        uint32_t sup = reg32(0);
+        sel = reg32(1);
+        rd32(sup + 4, &cls);
+    } else {
+        recv = reg32(1); sel = reg32(2);
+        if (recv) {
+            rd32(recv, &cls);
+        }
+    }
+    msg_key_t k = { st->site, cls, sel };
+    if (memcmp(&k, &st->last, sizeof(k)) == 0) {
+        return;
+    }
+    st->last = k;
+    msg_val_t *v = g_hash_table_lookup(msgs, &k);
+    if (!v) {
+        v = g_new0(msg_val_t, 1);
+        v->kind = st->kind;
+        v->cname = class_name(cls, &v->meta);
+        v->sname = rdstr(sel);
+        g_hash_table_insert(msgs, g_memdup2(&k, sizeof(k)), v);
+    }
+    v->count++;
+}
+
+static void write_calls(void)
+{
+    FILE *f = fopen(calls_name, "w");
+    GHashTableIter it;
+    gpointer key, val;
+    if (!f) {
+        fprintf(stderr, "drcov_mgst: cannot write calls=%s\n", calls_name);
+        return;
+    }
+    fprintf(f, "# drcov_mgst calls v1: edge src dst misses | msg site kind isa meta class selector misses\n");
+    g_hash_table_iter_init(&it, edges);
+    while (g_hash_table_iter_next(&it, &key, &val)) {
+        uint64_t e = (uint64_t)(uintptr_t)key;
+        fprintf(f, "edge\t0x%x\t0x%x\t%" PRIu64 "\n", (uint32_t)(e >> 32),
+                (uint32_t)e, (uint64_t)(uintptr_t)val);
+    }
+    g_hash_table_iter_init(&it, msgs);
+    while (g_hash_table_iter_next(&it, &key, &val)) {
+        msg_key_t *k = key;
+        msg_val_t *v = val;
+        fprintf(f, "msg\t0x%x\t%s\t0x%x\t%d\t%s\t%s\t%" PRIu64 "\n", k->site,
+                kind_name[v->kind], k->cls, v->meta, v->cname, v->sname, v->count);
+    }
+    fclose(f);
+    fprintf(stderr, "drcov_mgst: %u edge(s), %u msgSend tuple(s) written to %s\n",
+            g_hash_table_size(edges), g_hash_table_size(msgs), calls_name);
+}
+
+static void printf_header(unsigned long count)
+{
+    fprintf(fp, "%s", header);
+    fprintf(fp, "0, 0x%" PRIx64 ", 0x%" PRIx64 ", 0x%" PRIx64 ", %s\n",
+            mod_base, mod_end, mod_base, module_path);
+    fprintf(fp, "BB Table: %ld bbs\n", count);
+}
+
+static void printf_char_array32(uint32_t data)
+{
+    fwrite((const uint8_t *)&data, sizeof(char), sizeof(data), fp);
+}
+
+static void printf_char_array16(uint16_t data)
+{
+    fwrite((const uint8_t *)&data, sizeof(char), sizeof(data), fp);
+}
+
+static void printf_el(gpointer data, gpointer user_data)
+{
+    bb_entry_t *bb = (bb_entry_t *)data;
+    if (bb->state == BB_MGST) {
+        printf_char_array32((uint32_t)(bb->start - mod_base));
+        printf_char_array16(bb->size);
+        printf_char_array16(bb->mod_id);
+    }
+    g_free(bb);
+}
+
+static void count_block(gpointer data, gpointer user_data)
+{
+    unsigned long *count = (unsigned long *) user_data;
+    bb_entry_t *bb = (bb_entry_t *)data;
+    if (bb->state == BB_MGST) {
+        *count = *count + 1;
+    }
+}
+
+static void plugin_exit(qemu_plugin_id_t id, void *p)
+{
+    unsigned long count = 0;
+    g_mutex_lock(&lock);
+    g_ptr_array_foreach(blocks, count_block, &count);
+
+    if (calls_name) {
+        write_calls();   /* before printf_el frees the blocks */
+    }
+    printf_header(count);
+    g_ptr_array_foreach(blocks, printf_el, NULL);
+
+    g_ptr_array_free(blocks, true);
+    fclose(fp);
+    g_mutex_unlock(&lock);
+
+    fprintf(stderr, "drcov_mgst: %lu covered block(s) written to %s; "
+            "%" PRIu64 " TB(s) in range, %" PRIu64 " out of range (no "
+            "callback); identity check ran %" PRIu64 " time(s), matched "
+            "MGSTUS %" PRIu64 " (%.1f%%)\n",
+            count, file_name, tbs_in_range, tbs_skipped,
+            checks_total, checks_matched,
+            checks_total ? 100.0 * checks_matched / checks_total : 0.0);
+}
+
+static void vcpu_tb_exec(unsigned int cpu_index, void *udata)
+{
+    bb_entry_t *bb = (bb_entry_t *) udata;
+    /* Fast path: verdict already cached. The guest has ONE vCPU (ARM1176),
+     * so TB execution is serialised and needs no lock here. */
+    if (bb->state == BB_UNKNOWN) {
+        bb->state = current_context_is_mgst() ? BB_MGST : BB_OTHER;
+    }
+    if (!calls_name || bb->state != BB_MGST) {
+        return;
+    }
+    if (prev_bb && prev_bb->last_succ != bb->start) {
+        gpointer key = (gpointer)(uintptr_t)(((uint64_t)prev_bb->last_insn << 32) | bb->start);
+        uintptr_t n = (uintptr_t)g_hash_table_lookup(edges, key);
+        g_hash_table_insert(edges, key, (gpointer)(n + 1));
+        prev_bb->last_succ = bb->start;
+    }
+    prev_bb = bb;
+}
+
+static void vcpu_tb_trans(qemu_plugin_id_t id, struct qemu_plugin_tb *tb)
+{
+    uint64_t pc = qemu_plugin_tb_vaddr(tb);
+    size_t n = qemu_plugin_tb_n_insns(tb);
+
+    if (pc < mod_base || pc >= mod_end) {
+        tbs_skipped++;
+        return;   /* not MGSTUS's range: no entry, no callback, full speed */
+    }
+
+    g_mutex_lock(&lock);
+    tbs_in_range++;
+
+    bb_entry_t *bb = g_new0(bb_entry_t, 1);
+    for (int i = 0; i < n; i++) {
+        bb->size += qemu_plugin_insn_size(qemu_plugin_tb_get_insn(tb, i));
+    }
+
+    bb->start = pc;
+    bb->mod_id = 0;
+    bb->state = BB_UNKNOWN;
+    bb->last_insn = (uint32_t)qemu_plugin_insn_vaddr(qemu_plugin_tb_get_insn(tb, n - 1));
+    g_ptr_array_add(blocks, bb);
+
+    g_mutex_unlock(&lock);
+    /* current_context_is_mgst() only reads guest MEMORY through the vaddr
+     * helper, not CPU registers, so QEMU_PLUGIN_CB_NO_REGS is correct. */
+    qemu_plugin_register_vcpu_tb_exec_cb(tb, vcpu_tb_exec,
+                                         QEMU_PLUGIN_CB_NO_REGS,
+                                         (void *)bb);
+    if (!calls_name || !reg_r[0]) {
+        return;
+    }
+    /* Thumb-1 BL/BLX pair (ARMv6 has no other 32-bit Thumb encodings). */
+    for (size_t i = 0; i < n; i++) {
+        struct qemu_plugin_insn *insn = qemu_plugin_tb_get_insn(tb, i);
+        uint16_t h[2];
+        if (qemu_plugin_insn_size(insn) != 4 || qemu_plugin_insn_data(insn, h, 4) != 4) {
+            continue;
+        }
+        if ((h[0] & 0xf800) != 0xf000 ||
+            ((h[1] & 0xf800) != 0xf800 && (h[1] & 0xf800) != 0xe800)) {
+            continue;
+        }
+        uint64_t ipc = qemu_plugin_insn_vaddr(insn);
+        int32_t off = ((h[0] & 0x7ff) << 12) | ((h[1] & 0x7ff) << 1);
+        if (off & 0x400000) {
+            off -= 0x800000;
+        }
+        uint64_t tgt = ipc + 4 + off;
+        if ((h[1] & 0xf800) == 0xe800) {
+            tgt &= ~3ull;
+        }
+        int kind = tgt == stub_msgsend ? K_MSGSEND : tgt == stub_super2 ? K_SUPER2 :
+                   tgt == stub_stret ? K_STRET : -1;
+        if (kind < 0) {
+            continue;
+        }
+        site_t *st = g_new0(site_t, 1);
+        st->site = (uint32_t)ipc;
+        st->kind = kind;
+        st->bb = bb;
+        st->last.site = 0xffffffff;
+        qemu_plugin_register_vcpu_insn_exec_cb(insn, msg_exec, QEMU_PLUGIN_CB_R_REGS, st);
+    }
+}
+
+static bool load_ref_header(const char *path)
+{
+    FILE *f = fopen(path, "rb");
+    if (!f) {
+        fprintf(stderr, "drcov_mgst: cannot open ref=%s: %s\n",
+                path, strerror(errno));
+        return false;
+    }
+    size_t got = fread(ref_header, 1, sizeof(ref_header), f);
+    fclose(f);
+    if (got != sizeof(ref_header)) {
+        fprintf(stderr, "drcov_mgst: ref=%s too short (%zu bytes)\n",
+                path, got);
+        return false;
+    }
+    return true;
+}
+
+QEMU_PLUGIN_EXPORT
+int qemu_plugin_install(qemu_plugin_id_t id, const qemu_info_t *info,
+                        int argc, char **argv)
+{
+    for (int i = 0; i < argc; i++) {
+        g_auto(GStrv) tokens = g_strsplit(argv[i], "=", 2);
+        if (g_strcmp0(tokens[0], "filename") == 0) {
+            file_name = g_strdup(tokens[1]);
+        } else if (g_strcmp0(tokens[0], "ref") == 0) {
+            ref_path = g_strdup(tokens[1]);
+        } else if (g_strcmp0(tokens[0], "base") == 0) {
+            mod_base = g_ascii_strtoull(tokens[1], NULL, 16);
+        } else if (g_strcmp0(tokens[0], "end") == 0) {
+            mod_end = g_ascii_strtoull(tokens[1], NULL, 16);
+        } else if (g_strcmp0(tokens[0], "calls") == 0) {
+            calls_name = g_strdup(tokens[1]);
+        } else if (g_strcmp0(tokens[0], "msgsend") == 0) {
+            stub_msgsend = g_ascii_strtoull(tokens[1], NULL, 16);
+        } else if (g_strcmp0(tokens[0], "super2") == 0) {
+            stub_super2 = g_ascii_strtoull(tokens[1], NULL, 16);
+        } else if (g_strcmp0(tokens[0], "stret") == 0) {
+            stub_stret = g_ascii_strtoull(tokens[1], NULL, 16);
+        }
+    }
+
+    if (!ref_path) {
+        fprintf(stderr, "drcov_mgst: missing required ref=<path to MGSTUS>\n");
+        return -1;
+    }
+    have_ref = load_ref_header(ref_path);
+    if (!have_ref) {
+        return -1;
+    }
+
+    fp = fopen(file_name, "wb");
+    if (!fp) {
+        fprintf(stderr, "drcov_mgst: cannot open filename=%s: %s\n",
+                file_name, strerror(errno));
+        return -1;
+    }
+    blocks = g_ptr_array_sized_new(4096);
+    if (calls_name) {
+        edges = g_hash_table_new(g_direct_hash, g_direct_equal);
+        msgs = g_hash_table_new(msg_hash, msg_equal);
+        qemu_plugin_register_vcpu_init_cb(id, vcpu_init);
+    }
+
+    qemu_plugin_register_vcpu_tb_trans_cb(id, vcpu_tb_trans);
+    qemu_plugin_register_atexit_cb(id, plugin_exit, NULL);
+
+    return 0;
+}
