+static bool gles_egl_init(void)
+{
+    static bool tried;
+    PFNEGLGETPLATFORMDISPLAYEXTPROC get_platform_display;
+    EGLint major, minor, n = 0;
+    /* EGL_SURFACE_TYPE defaults to EGL_WINDOW_BIT, and a surfaceless display
+     * has pbuffer-only configs, so without DONT_CARE the choice comes back
+     * empty and every context fails with EGL_BAD_CONFIG. */
+    static const EGLint cfg_attrs[] = {
+        EGL_RENDERABLE_TYPE, EGL_OPENGL_BIT,
+        EGL_SURFACE_TYPE, EGL_DONT_CARE,
+        EGL_NONE,
+    };
+
+    if (gles_egl_dpy != EGL_NO_DISPLAY) return true;
+    if (tried) return false;
+    tried = true;
+
+    if (getenv("IT_GLES_EGL_SOFTWARE")) {
+        setenv("LIBGL_ALWAYS_SOFTWARE", "1", 1);
+    }
+    get_platform_display = (PFNEGLGETPLATFORMDISPLAYEXTPROC)
+        eglGetProcAddress("eglGetPlatformDisplayEXT");
+    if (get_platform_display) {
+        gles_egl_dpy = get_platform_display(EGL_PLATFORM_SURFACELESS_MESA,
+                                            EGL_DEFAULT_DISPLAY, NULL);
+    }
+    if (gles_egl_dpy == EGL_NO_DISPLAY) {
+        gles_egl_dpy = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+    }
+    if (gles_egl_dpy == EGL_NO_DISPLAY ||
+        !eglInitialize(gles_egl_dpy, &major, &minor)) {
+        fprintf(stderr, "[gles] EGL: no usable display (0x%x)\n", eglGetError());
+        gles_egl_dpy = EGL_NO_DISPLAY;
+        return false;
+    }
+    if (!eglBindAPI(EGL_OPENGL_API) ||
+        !eglChooseConfig(gles_egl_dpy, cfg_attrs, &gles_egl_cfg, 1, &n) || n < 1) {
+        fprintf(stderr, "[gles] EGL %d.%d: no desktop-GL config (0x%x)\n",
+                major, minor, eglGetError());
+        eglTerminate(gles_egl_dpy);
+        gles_egl_dpy = EGL_NO_DISPLAY;
+        return false;
+    }
+    fprintf(stderr, "[gles] EGL %d.%d (%s), surfaceless desktop GL\n", major, minor,
+            eglQueryString(gles_egl_dpy, EGL_VENDOR));
+    return true;
+}
+
+static EGLContext gles_egl_new_context(EGLContext share)
+{
+    static const EGLint attrs[] = {
+        EGL_CONTEXT_MAJOR_VERSION, 2,
+        EGL_CONTEXT_MINOR_VERSION, 1,
+        EGL_NONE,
+    };
+    return eglCreateContext(gles_egl_dpy, gles_egl_cfg,
+                            share ? share : EGL_NO_CONTEXT, attrs);
+}
+
+static inline void gles_native_set_current(CGLContextObj ctx)
+{
+    eglMakeCurrent(gles_egl_dpy, EGL_NO_SURFACE, EGL_NO_SURFACE,
+                   ctx ? ctx : EGL_NO_CONTEXT);
+}
+
+static inline void gles_native_release(CGLContextObj ctx)
+{
+    if (ctx && gles_egl_dpy != EGL_NO_DISPLAY) {
+        eglDestroyContext(gles_egl_dpy, ctx);
+    }
+}
+
+static bool gles_platform_context_create(void)
+{
+    if (!gles_egl_init()) return false;
+    /*
+     * CGL keeps a sharegroup alive by retaining its first context as the
+     * group's root. EGL has no retain, so the group gets a context of its own
+     * to play that part: every member shares with it, and it is destroyed only
+     * when the group is.
+     */
+    if (gh.group && !gh.group->root) {
+        gh.group->root = gles_egl_new_context(NULL);
+        if (!gh.group->root) {
+            fprintf(stderr, "[gles] EGL: sharegroup root failed (0x%x)\n", eglGetError());
+            return false;
+        }
+    }
+    gh.cgl = gles_egl_new_context(gh.group ? gh.group->root : NULL);
+    if (!gh.cgl) {
+        fprintf(stderr, "[gles] eglCreateContext failed (0x%x)\n", eglGetError());
+        return false;
+    }
+    if (!eglMakeCurrent(gles_egl_dpy, EGL_NO_SURFACE, EGL_NO_SURFACE, gh.cgl)) {
+        fprintf(stderr, "[gles] eglMakeCurrent (surfaceless) failed (0x%x)\n",
+                eglGetError());
+        eglDestroyContext(gles_egl_dpy, gh.cgl);
+        gh.cgl = NULL;
+        return false;
+    }
+    return true;
+}
