+/*
+ * The VideoToolbox transfer below, in plain C: bi-planar 4:2:0 (a Y plane then
+ * interleaved Cb,Cr at half resolution, both with stride w) to B,G,R,A bytes,
+ * ITU-R BT.601 -- the matrix the macOS path pins. '420v' is video range
+ * (Y 16..235, C 16..240), '420f' full range.
+ */
+static bool gles_surface_nv12(unsigned w, unsigned h, uint32_t format,
+                              uint8_t *input, uint8_t *bgra)
+{
+    const bool full = format == 0x34323066;           /* '420f' */
+    const int ky = full ? 256 : 298;                   /* 8.8 fixed point */
+    const int y0 = full ? 0 : 16;
+    const int kr = full ? 359 : 409, kb = full ? 454 : 516;
+    const int kgu = full ? 88 : 100, kgv = full ? 183 : 208;
+    const uint8_t *yp = input, *uvp = input + (size_t)w * h;
+
+    for (unsigned y = 0; y < h; y++) {
+        const uint8_t *yrow = yp + (size_t)y * w;
+        const uint8_t *uvrow = uvp + (size_t)(y / 2) * w;
+        uint8_t *out = bgra + (size_t)y * w * 4;
+        for (unsigned x = 0; x < w; x++) {
+            int c = ky * ((int)yrow[x] - y0);
+            int u = (int)uvrow[x & ~1u] - 128, v = (int)uvrow[(x & ~1u) + 1] - 128;
+            int r = (c + kr * v + 128) >> 8;
+            int g = (c - kgu * u - kgv * v + 128) >> 8;
+            int b = (c + kb * u + 128) >> 8;
+            out[x * 4 + 0] = b < 0 ? 0 : b > 255 ? 255 : b;
+            out[x * 4 + 1] = g < 0 ? 0 : g > 255 ? 255 : g;
+            out[x * 4 + 2] = r < 0 ? 0 : r > 255 ? 255 : r;
+            out[x * 4 + 3] = 255;
+        }
+    }
+    return true;
+}
